{
  "name": "chat-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @app/server --filter @app/web dev",
    "start": "node apps/server/src/main.ts",
    "build": "pnpm --filter @app/web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "release": "pnpm build && node scripts/build-release.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
